[Unit]
Description=Conduit Security Gateway Management API & UI
After=network.target valkey.service valkey-server.service redis.service redis-server.service conduit-dragonfly.service
Wants=valkey.service

[Service]
Type=simple
WorkingDirectory=%h/conduit
UnsetEnvironment=http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
Environment=CONDUIT_CONFIG=%h/conduit/conduit.toml
Environment=RUST_LOG=info
ExecStartPre=/usr/bin/bash -c 'for i in {1..50}; do (echo > /dev/tcp/127.0.0.1/6379 || echo > /dev/tcp/127.0.0.1/6380 || nc -z 127.0.0.1 6379 || nc -z 127.0.0.1 6380) 2>/dev/null && exit 0; sleep 0.2; done; exit 1'
ExecStart=%h/conduit/target/release/conduit-api
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/conduit/logs/api.log
StandardError=append:%h/conduit/logs/api.log

[Install]
WantedBy=default.target
